{
  "name": "@voxelkloud/loader",
  "version": "0.1.0",
  "description": "Streaming loader for Potree v2 point cloud data (metadata.json/hierarchy.bin/octree.bin) over HTTP Range requests.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "potree",
    "lidar",
    "loader",
    "streaming",
    "range-requests",
    "las",
    "brotli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/loader.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brotli": {
      "types": "./dist/brotli/index.d.ts",
      "import": "./dist/brotli/index.js"
    }
  },
  "imports": {
    "#brotli-native": {
      "node": "./dist/point-data-brotli-node.js",
      "default": "./dist/point-data-brotli-none.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voxelkloud/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
